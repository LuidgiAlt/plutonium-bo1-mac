+static bool wined3d_context_vk_create_cb_ring_bo(struct wined3d_context_vk *context_vk,
+        VkDeviceSize size, VkBufferUsageFlags usage, VkMemoryPropertyFlags memory_type, struct wined3d_bo_vk *bo)
+{
+    const struct wined3d_adapter_vk *adapter_vk = wined3d_adapter_vk(context_vk->c.device->adapter);
+    struct wined3d_device_vk *device_vk = wined3d_device_vk(context_vk->c.device);
+    const struct wined3d_vk_info *vk_info = context_vk->vk_info;
+    VkDeviceSize offset, start;
+    unsigned int next;
+
+    if (size > WINED3D_VK_CB_RING_CHUNK_SIZE || !(usage & VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT)
+            || !(memory_type & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+        return false;
+    /* Only the CS thread; the ring has no lock. Slab backings never. */
+    if (context_vk->cb_ring.bypass || context_vk->c.device->cs->thread_id != GetCurrentThreadId())
+        return false;
+
+    if (!context_vk->cb_ring.valid)
+    {
+        if (context_vk->cb_ring.failed)
+            return false;
+        context_vk->cb_ring.failed = true;
+        if (!wined3d_context_vk_create_bo(context_vk,
+                (VkDeviceSize)WINED3D_VK_CB_RING_CHUNK_SIZE * WINED3D_VK_CB_RING_CHUNKS,
+                usage, memory_type, &context_vk->cb_ring.bo))
+            return false;
+        if (context_vk->cb_ring.bo.memory)
+            context_vk->cb_ring.bo.b.map_ptr = wined3d_allocator_chunk_vk_map(
+                    wined3d_allocator_chunk_vk(context_vk->cb_ring.bo.memory->chunk), context_vk);
+        else if (VK_CALL(vkMapMemory(device_vk->vk_device, context_vk->cb_ring.bo.vk_memory,
+                0, VK_WHOLE_SIZE, 0, &context_vk->cb_ring.bo.b.map_ptr)) < 0)
+            context_vk->cb_ring.bo.b.map_ptr = NULL;
+        else
+            adapter_adjust_mapped_memory(device_vk->d.adapter, context_vk->cb_ring.bo.size);
+        if (!context_vk->cb_ring.bo.b.map_ptr)
+        {
+            wined3d_context_vk_destroy_bo(context_vk, &context_vk->cb_ring.bo);
+            return false;
+        }
+        context_vk->cb_ring.usage = usage;
+        context_vk->cb_ring.memory_type = memory_type;
+        context_vk->cb_ring.alignment = max(adapter_vk->device_limits.minUniformBufferOffsetAlignment, 16);
+        context_vk->cb_ring.chunk = 0;
+        context_vk->cb_ring.chunk_offset = 0;
+        context_vk->cb_ring.valid = true;
+        context_vk->cb_ring.failed = false;
+    }
+    /* Renames ask for the memory type the previous slice actually has. */
+    if (usage != context_vk->cb_ring.usage
+            || (context_vk->cb_ring.bo.memory_type & memory_type) != memory_type)
+        return false;
 
+    offset = (context_vk->cb_ring.chunk_offset + context_vk->cb_ring.alignment - 1)
+            & ~(context_vk->cb_ring.alignment - 1);
+    if (offset + size > WINED3D_VK_CB_RING_CHUNK_SIZE)
+    {
+        next = (context_vk->cb_ring.chunk + 1) % WINED3D_VK_CB_RING_CHUNKS;
+        if (context_vk->cb_ring.live[next]
+                || context_vk->cb_ring.last_use[next] > context_vk->completed_command_buffer_id)
+            return false;
+        context_vk->cb_ring.chunk = next;
+        offset = 0;
+    }
+    context_vk->cb_ring.chunk_offset = offset + size;
+    ++context_vk->cb_ring.live[context_vk->cb_ring.chunk];
+
+    start = (VkDeviceSize)context_vk->cb_ring.chunk * WINED3D_VK_CB_RING_CHUNK_SIZE + offset;
+    *bo = context_vk->cb_ring.bo;
+    bo->memory = NULL;
+    bo->slab = NULL;
+    bo->cb_ring = true;
+    bo->b.refcount = 1;
+    bo->b.client_map_count = 0;
+    bo->b.map_ptr = context_vk->cb_ring.bo.b.map_ptr;
+    bo->b.buffer_offset = context_vk->cb_ring.bo.b.buffer_offset + start;
+    bo->b.memory_offset = context_vk->cb_ring.bo.b.memory_offset + start;
+    bo->size = size;
+    list_init(&bo->b.users);
+    bo->command_buffer_id = 0;
+    bo->host_synced = false;
     return true;
 }
 
