+    /* Persistent pipeline cache, so pipelines compiled in earlier runs are reused. */
+    VkPipelineCache vk_pipeline_cache;
+    LONG pipeline_cache_new;
+    DWORD pipeline_cache_last_new;
+    HANDLE pipeline_cache_thread, pipeline_cache_stop;
+    WCHAR pipeline_cache_path[MAX_PATH];
 };
 
 static inline struct wined3d_device_vk *wined3d_device_vk(struct wined3d_device *device)
 {
