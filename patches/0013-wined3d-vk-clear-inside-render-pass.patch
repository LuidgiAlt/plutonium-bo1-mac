+/* A delayed clear of a view that the current render pass already uses can be
+ * done inside the pass. Ending the pass and starting a new one that clears on
+ * load makes tile-based GPUs store and reload every attachment; Direct3D 9
+ * games clear like this many times per frame. */
+static bool wined3d_context_vk_clear_in_render_pass(struct wined3d_context_vk *context_vk,
+        struct wined3d_rendertarget_view *rtv)
+{
+    const struct wined3d_vk_info *vk_info = context_vk->vk_info;
+    struct wined3d_texture *texture;
+    VkClearAttachment clear;
+    VkClearRect rect;
+    unsigned int i;
+
+    if (!context_vk->vk_render_pass || context_vk->hack_render_area_trimmed_to_viewport
+            || wined3d_context_is_graphics_state_dirty(&context_vk->c, STATE_FRAMEBUFFER)
+            || rtv->resource->type == WINED3D_RTYPE_BUFFER
+            || rtv->width != context_vk->render_pass_width || rtv->height != context_vk->render_pass_height)
+        return false;
+
+    texture = texture_from_resource(rtv->resource);
+    if (rtv == context_vk->render_pass_dsv)
+    {
+        clear.aspectMask = 0;
+        if (rtv->format->depth_size)
+            clear.aspectMask |= VK_IMAGE_ASPECT_DEPTH_BIT;
+        if (rtv->format->stencil_size)
+            clear.aspectMask |= VK_IMAGE_ASPECT_STENCIL_BIT;
+        if (!clear.aspectMask)
+            return false;
+        clear.colorAttachment = 0;
+        clear.clearValue.depthStencil.depth = texture->sub_resources[rtv->sub_resource_idx].clear_value.depth;
+        clear.clearValue.depthStencil.stencil = texture->sub_resources[rtv->sub_resource_idx].clear_value.stencil;
+    }
+    else
+    {
+        for (i = 0; i < ARRAY_SIZE(context_vk->render_pass_rtvs); ++i)
+        {
+            if (context_vk->render_pass_rtvs[i] == rtv)
+                break;
+        }
+        if (i == ARRAY_SIZE(context_vk->render_pass_rtvs))
+            return false;
+        /* Subpass colour attachments are indexed by render target slot. */
+        clear.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        clear.colorAttachment = i;
+        wined3d_format_colour_to_vk(rtv->format,
+                &texture->sub_resources[rtv->sub_resource_idx].clear_value.colour, &clear.clearValue.color);
+    }
+
+    rect.rect.offset.x = 0;
+    rect.rect.offset.y = 0;
+    rect.rect.extent.width = rtv->width;
+    rect.rect.extent.height = rtv->height;
+    rect.baseArrayLayer = 0;
+    rect.layerCount = rtv->layer_count;
+    TRACE("Clearing view %p inside the render pass.\n", rtv);
+    VK_CALL(vkCmdClearAttachments(context_vk->current_command_buffer.vk_command_buffer, 1, &clear, 1, &rect));
+
+    wined3d_rendertarget_view_validate_location(rtv, rtv->resource->draw_binding);
+    wined3d_rendertarget_view_invalidate_location(rtv, ~rtv->resource->draw_binding);
+    return true;
+}
+
 static void wined3d_context_vk_prepare_used_rtv(struct wined3d_context_vk *context_vk, struct wined3d_rendertarget_view *rtv)
 {
     if (wined3d_rendertarget_view_get_locations(rtv) & WINED3D_LOCATION_CLEARED)
     {
+        if (wined3d_context_vk_clear_in_render_pass(context_vk, rtv))
+            return;
         /* Need to restart render pass or the clear won't happen. */
         wined3d_context_vk_end_current_render_pass(context_vk);
         wined3d_rendertarget_view_prepare_location(rtv, &context_vk->c, rtv->resource->draw_binding);
