         wined3d_rendertarget_view_vk_barrier(rtv_vk, context_vk, WINED3D_BIND_DEPTH_STENCIL);
+        context_vk->render_pass_dsv = view;
         wined3d_context_vk_reference_rendertarget_view(context_vk, rtv_vk);
 
