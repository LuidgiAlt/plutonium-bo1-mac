@@ -152,6 +153,35 @@
             }
 
             args->u.vs.clip_planes = state->extra_vs_args.clip_planes;
+
+            /* Direct3D 9 integer vertex attributes reach the shader as
+             * floats; the shader has to declare them as integers and
+             * convert them itself. */
+            if (shader->reg_maps.shader_version.major < 4 && state->vertex_declaration)
+            {
+                struct wined3d_stream_info stream_info;
+                unsigned int i;
+
+                wined3d_stream_info_from_declaration(&stream_info, state, context->d3d_info);
+                for (i = 0; i < ARRAY_SIZE(stream_info.elements); ++i)
+                {
+                    if (!(stream_info.use_map & (1u << i)))
+                        continue;
+                    switch (stream_info.elements[i].format->id)
+                    {
+                        case WINED3DFMT_R8G8B8A8_UINT:
+                        case WINED3DFMT_R10G10B10X2_UINT:
+                            args->u.vs.uint_inputs |= 1u << i;
+                            break;
+                        case WINED3DFMT_R16G16_SINT:
+                        case WINED3DFMT_R16G16B16A16_SINT:
+                            args->u.vs.sint_inputs |= 1u << i;
+                            break;
+                        default:
+                            break;
+                    }
+                }
+            }
             break;
         }
 
@@ -197,7 +227,16 @@
     fill_buffer_parameter(&parameters[11], ffp_extra_binding, VKD3D_SHADER_PARAMETER_NAME_POINT_SIZE_MAX,
             VKD3D_SHADER_PARAMETER_DATA_TYPE_FLOAT32, offsetof(struct wined3d_ffp_vs_constants, point_clamp.max));
 
-    vkd3d_args->parameter_info.parameter_count = 12;
+    parameters[12].name = VKD3D_SHADER_PARAMETER_NAME_SM1_UINT_INPUT_MASK;
+    parameters[12].type = VKD3D_SHADER_PARAMETER_TYPE_IMMEDIATE_CONSTANT;
+    parameters[12].data_type = VKD3D_SHADER_PARAMETER_DATA_TYPE_UINT32;
+    parameters[12].u.immediate_constant.u.u32 = compile_args->u.vs.uint_inputs;
+    parameters[13].name = VKD3D_SHADER_PARAMETER_NAME_SM1_SINT_INPUT_MASK;
+    parameters[13].type = VKD3D_SHADER_PARAMETER_TYPE_IMMEDIATE_CONSTANT;
+    parameters[13].data_type = VKD3D_SHADER_PARAMETER_DATA_TYPE_UINT32;
+    parameters[13].u.immediate_constant.u.u32 = compile_args->u.vs.sint_inputs;
+
+    vkd3d_args->parameter_info.parameter_count = 14;
     vkd3d_args->parameter_info.parameters = vkd3d_args->parameters;
 }
 
