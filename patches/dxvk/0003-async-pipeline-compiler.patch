--- /dev/null
+++ b/src/util/util_stall.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <chrono>
+
+#include "log/log.h"
+#include "util_env.h"
+#include "util_string.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Logs a scope that took longer than 5 ms
+   *
+   * Diagnostic, enabled with DXVK_STALL_LOG=1: one warning per slow call,
+   * with the thread name, to find what blocks a frame.
+   */
+  class StallTimer {
+
+  public:
+
+    explicit StallTimer(const char* what)
+    : m_what(what) {
+      if (enabled())
+        m_start = std::chrono::steady_clock::now();
+    }
+
+    ~StallTimer() {
+      if (!enabled())
+        return;
+
+      auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - m_start).count();
+
+      if (us >= 5000)
+        Logger::warn(str::format("stall: ", m_what, " ", us / 1000, " ms"));
+    }
+
+    static bool enabled() {
+      static const bool on = env::getEnvVar("DXVK_STALL_LOG") == "1";
+      return on;
+    }
+
+  private:
+
+    const char* m_what;
+    std::chrono::steady_clock::time_point m_start;
+
+  };
+
+}
